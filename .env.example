# Database Connection (PostgreSQL or SQLite for local dev)
# Example PostgreSQL: postgresql://user:password@localhost:5432/medcentre?schema=public
# Example SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# Server Environment & Port Configuration
NODE_ENV="development"
PORT=3000

# Public Base URL for API & Client Navigation
NEXT_PUBLIC_APP_URL="http://localhost:3000"
