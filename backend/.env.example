# MedCentre Backend Environment Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite for Prisma)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="medcentre_production_jwt_secret_key_change_me_in_prod_12345"
JWT_REFRESH_SECRET="medcentre_production_jwt_refresh_secret_key_change_me_12345"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Optional OCR Service Key
OCR_API_KEY=""
